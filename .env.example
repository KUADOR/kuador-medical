# Copy to .env and fill in the empty values. .env is git-ignored: never commit it.
# Names and meaning: docs/deployment.md § Variables y secretos.

# --- Database (compose service "db") ---
DB_NAME=medical
DB_USERNAME=medical
# Secret. Any local value, e.g. generated with: openssl rand -base64 24
DB_PASSWORD=
DB_PORT=5432
# Used when the api runs on the host. In the "full" compose profile it is overridden to host "db".
DB_URL=jdbc:postgresql://localhost:5432/medical

# --- api ---
SPRING_PROFILES_ACTIVE=local
API_PORT=8080
# Secret. At least 256 bits, e.g.: openssl rand -base64 48
KUADOR_JWT_SECRET=
KUADOR_JWT_TTL=PT30M
# Initial SUPER_ADMIN account, created only if no platform admin exists yet.
# Email: the one agreed in MEDK-1. Password: secret, must be changed on first login.
KUADOR_BOOTSTRAP_ADMIN_EMAIL=
KUADOR_BOOTSTRAP_ADMIN_PASSWORD=
KUADOR_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- web ---
WEB_PORT=4200
API_BASE_URL=http://localhost:8080/api/v1
