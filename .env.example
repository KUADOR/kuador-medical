# Copy to .env and fill in the empty values. .env is git-ignored: never commit it.
# Names and meaning: docs/deployment.md § Variables y secretos.

# --- Database (compose service "db") ---
DB_NAME=medical
DB_USERNAME=medical
# Secret. Any local value, e.g. generated with: openssl rand -base64 24
DB_PASSWORD=
DB_PORT=5432
# Used when the api runs on the host. In the "full" compose profile it is overridden to host "db".
DB_URL=jdbc:postgresql://localhost:5432/medical

# --- api ---
SPRING_PROFILES_ACTIVE=local
API_PORT=8080
# Secret. At least 256 bits, e.g.: openssl rand -base64 48
KUADOR_JWT_SECRET=
# Secret. Encrypts the TOTP second factor secrets (ADR-019). At least 32 bytes, e.g.: openssl rand -base64 48
KUADOR_TOTP_ENCRYPTION_KEY=
# Secret, local only. Password of the two seed test users of the "local" profile (>= 12 chars).
LOCAL_SEED_PASSWORD=
# Token lifetimes (ISO-8601 durations, ADR-013).
KUADOR_JWT_TTL=PT15M
KUADOR_JWT_REFRESH_TTL=P7D
KUADOR_JWT_PRE_AUTH_TTL=PT5M
# Login attempt limit per email + IP and per account.
KUADOR_LOGIN_MAX_FAILURES=5
KUADOR_LOGIN_FAILURE_WINDOW=PT15M
KUADOR_LOGIN_LOCK_DURATION=PT15M
# One-time token lifetimes (ADR-014).
KUADOR_INVITATION_TTL=PT72H
KUADOR_PASSWORD_RESET_TTL=PT30M
KUADOR_EMAIL_VERIFICATION_TTL=PT24H
# Links in emails. App link base defaults to the web URL (same link opens the app or the web).
KUADOR_WEB_BASE_URL=http://localhost:4200
KUADOR_APP_LINK_BASE_URL=
# Temporary staff user limit for every clinic until plans exist; empty or 0 = no limit.
KUADOR_PLAN_USER_LIMIT=
# Time zone (IANA id) used to tell minor patients (under 18) apart (per-clinic zone to be defined).
# Must not be blank: an empty value stops the api at startup. Default UTC.
KUADOR_CLINIC_TIME_ZONE=UTC
# Initial SUPER_ADMIN account, created only if no platform admin exists yet.
# Email: the one agreed in MEDK-1. Password: secret, must be changed on first login.
KUADOR_BOOTSTRAP_ADMIN_EMAIL=
KUADOR_BOOTSTRAP_ADMIN_PASSWORD=
KUADOR_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Email (local: Mailpit from compose.yaml, UI on http://localhost:8025) ---
# The "local" profile already points to Mailpit on localhost:1025 without auth or STARTTLS.
KUADOR_SMTP_HOST=localhost
KUADOR_SMTP_PORT=1025
KUADOR_SMTP_AUTH=false
KUADOR_SMTP_STARTTLS=false
KUADOR_SMTP_USERNAME=
# Secret outside local (Mailpit needs none).
KUADOR_SMTP_PASSWORD=
KUADOR_MAIL_FROM=no-reply@medical.example.test
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- SMS (provider to be defined; empty provider keeps SMS disabled) ---
KUADOR_SMS_PROVIDER=
# Secret.
KUADOR_SMS_API_KEY=
KUADOR_SMS_SENDER=

# --- web ---
WEB_PORT=4200
API_BASE_URL=http://localhost:8080/api/v1
# App Links / Universal Links association files served by the web container (public values).
# Comma-separated lists; empty keeps the files without associated apps.
APP_LINKS_ANDROID_PACKAGE=com.kuador.medical_kuador
APP_LINKS_ANDROID_SHA256=
APP_LINKS_IOS_APP_IDS=

# --- scripts/smoke-test.sh (local only) ---
# Secret. Password the smoke test sets on the SUPER_ADMIN on its first run (>= 12 chars).
SMOKE_SUPER_ADMIN_NEW_PASSWORD=
