# Fail fast when the "local" (MEDK-29) or "prod" (MEDK-71) profile misses a required environment variable.
org.springframework.boot.EnvironmentPostProcessor=\
com.kuador.medical.shared.config.LocalEnvironmentValidator,\
com.kuador.medical.shared.config.ProdEnvironmentValidator

org.springframework.boot.diagnostics.FailureAnalyzer=\
com.kuador.medical.shared.config.MissingEnvironmentVariablesFailureAnalyzer
