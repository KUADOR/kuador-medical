# api on the host with the "local" profile (./mvnw spring-boot:run from api/).
# Copy to api/.env and fill in the empty values. api/.env is git-ignored: never commit it.
# The local profile imports api/.env when present; variables already set in the environment win.
# Names and meaning: docs/deployment.md § Variables y secretos.

SPRING_PROFILES_ACTIVE=local

# --- Required: the api does not start in the local profile without them ---
DB_URL=jdbc:postgresql://localhost:5432/medical
DB_USERNAME=medical
# Secret. Same value as DB_PASSWORD in the root .env (the compose database).
DB_PASSWORD=
# Secret. At least 256 bits, e.g.: openssl rand -base64 48
KUADOR_JWT_SECRET=
# Secret, local only. Password of the two seed test users (at least 12 characters).
# Changing it later requires recreating the local database.
LOCAL_SEED_PASSWORD=

# --- Optional ---
SERVER_PORT=8080
# 0.0.0.0 lets a physical device on the same network reach the api; 127.0.0.1 keeps it on this machine.
SERVER_ADDRESS=0.0.0.0
# Empty: no CORS (enough when the web uses its development proxy). Default: http://localhost:4200
KUADOR_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Initial SUPER_ADMIN account, created only if no platform admin exists yet (optional in local).
KUADOR_BOOTSTRAP_ADMIN_EMAIL=
KUADOR_BOOTSTRAP_ADMIN_PASSWORD=
