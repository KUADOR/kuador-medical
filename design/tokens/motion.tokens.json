{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "Hover, press, small state changes." },
      "normal": { "$value": "200ms", "$description": "Expanding, fading, moving within a view." },
      "slow": { "$value": "320ms", "$description": "Entering and leaving views, sheets and dialogs." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0, 1] },
      "exit": { "$value": [0.3, 0, 1, 1] }
    }
  }
}
