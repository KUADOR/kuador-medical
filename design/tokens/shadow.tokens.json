{
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": { "color": "#0000001a", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      "$extensions": {
        "com.kuador.modes": {
          "dark": { "color": "#00000066", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
        }
      }
    },
    "md": {
      "$value": { "color": "#0000001f", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" },
      "$extensions": {
        "com.kuador.modes": {
          "dark": { "color": "#00000080", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" }
        }
      }
    },
    "lg": {
      "$value": { "color": "#00000029", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" },
      "$extensions": {
        "com.kuador.modes": {
          "dark": { "color": "#00000099", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }
        }
      }
    }
  }
}
