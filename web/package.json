{
  "name": "medical-kuador-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --proxy-config proxy.mock.conf.json",
    "mock": "prism mock ../contracts/identity.openapi.yaml --port 4010",
    "dev:mock": "concurrently --kill-others --names mock,web \"npm run mock\" \"npm run start:mock\"",
    "api:generate": "openapi-typescript ../contracts/identity.openapi.yaml -o src/app/core/api/identity.schema.d.ts",
    "api:check": "openapi-typescript ../contracts/identity.openapi.yaml -o src/app/core/api/identity.schema.d.ts --check",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.8",
    "@angular/cli": "^22.2.8",
    "@angular/compiler-cli": "^22.2.0",
    "@stoplight/prism-cli": "^5.14.2",
    "concurrently": "^10.0.7",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  }
}
