{
  "name": "medical-kuador-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --proxy-config proxy.mock.conf.json",
    "mock": "concurrently --kill-others --names identity,registration,platform \"npm run mock:identity\" \"npm run mock:registration\" \"npm run mock:platform\"",
    "mock:identity": "prism mock ../contracts/identity.openapi.yaml --port 4010",
    "mock:registration": "prism mock ../contracts/user-registration.openapi.yaml --port 4011",
    "mock:platform": "prism mock ../contracts/platform.openapi.yaml --port 4012",
    "dev:mock": "concurrently --kill-others --names mock,web \"npm run mock\" \"npm run start:mock\"",
    "api:generate": "openapi-typescript ../contracts/identity.openapi.yaml -o src/app/core/api/identity.schema.d.ts && openapi-typescript ../contracts/user-registration.openapi.yaml -o src/app/core/api/user-registration.schema.d.ts && openapi-typescript ../contracts/platform.openapi.yaml -o src/app/core/api/platform.schema.d.ts",
    "api:check": "openapi-typescript ../contracts/identity.openapi.yaml -o src/app/core/api/identity.schema.d.ts --check && openapi-typescript ../contracts/user-registration.openapi.yaml -o src/app/core/api/user-registration.schema.d.ts --check && openapi-typescript ../contracts/platform.openapi.yaml -o src/app/core/api/platform.schema.d.ts --check",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "prebuild": "npm run lint",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run lint && npm run test:guards",
    "test": "ng test",
    "test:guards": "vitest run --config vitest.guards.config.mts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD/..:/repo\" -v medical-kuador-web-visual-modules:/repo/web/node_modules -w /repo/web -e CI=1 mcr.microsoft.com/playwright:v1.65.1-noble sh -c \"npm ci && npx playwright test --update-snapshots\"",
    "lighthouse": "npx --yes @lhci/cli@0.16.1 autorun",
    "lint": "npm run lint:styles && npm run lint:templates",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:templates": "eslint src"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.8",
    "@angular/cli": "^22.2.8",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.65.1",
    "@stoplight/prism-cli": "^5.14.2",
    "angular-eslint": "^22.8.0",
    "axe-core": "^4.14.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "stylelint": "^18.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  }
}
